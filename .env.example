# Copy to .env for local development. Replace the development password before deployment.
POSTGRES_DB=toolplanner
POSTGRES_USER=toolplanner
POSTGRES_PASSWORD=local-development-only
TOOLPLANNER_DATABASE_URL=postgresql+psycopg://toolplanner:local-development-only@postgres:5432/toolplanner
TOOLPLANNER_PUBLIC_BASE_URL=http://localhost:8080
TOOLPLANNER_COOKIE_SECURE=false
TOOLPLANNER_SESSION_TTL_HOURS=12
TOOLPLANNER_CORS_ORIGINS=["http://localhost:8080"]
